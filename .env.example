# Copy to .env and adjust for local development.
# docker compose and Make targets load these automatically.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Host-local connection (make run / make test / make migrate).
# The api service in docker-compose overrides the host to `postgres`.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable

HTTP_ADDR=:8080

# Required: HMAC secret for signing end-user JWTs (share with consumer backends that verify tokens).
JWT_SECRET=change-me-to-a-long-random-secret

# Optional JWT settings.
JWT_ISSUER=openaura
JWT_TTL=24h

# Optional: seed an admin API key on server startup.
BOOTSTRAP_ADMIN_API_KEY=
